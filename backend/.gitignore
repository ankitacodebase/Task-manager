# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
*.env
.env.*
.env.local
.env.development
.env.test
.env.production
!.env.example
*.local

# ==========================================
# Python Virtual Environments
# ==========================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
bin/
lib/
include/

# ==========================================
# Python Bytecode & Compilation Caches
# ==========================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# ==========================================
# Testing, Coverage & Profiling
# ==========================================
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# ==========================================
# Runtime Uploads & Generated Media
# ==========================================
uploads/*
!uploads/.gitkeep

# ==========================================
# Logs & Temporary Files
# ==========================================
*.log
logs/
*.tmp
*.temp

# ==========================================
# Database Local Files (If tested locally)
# ==========================================
*.sqlite
*.sqlite3
*.db

# ==========================================
# OS & Editor Artifacts
# ==========================================
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.sw?
*~
