APP_NAME=TaskFlow Enterprise Platform
ENVIRONMENT=development
DEBUG=True

# ==========================================
# Database Configuration (MySQL 8.0 / 8.4 LTS)
# ==========================================
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=your_mysql_password_here
DATABASE_NAME=taskflow_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ==========================================
# Security & JWT Token Configuration
# Note: JWT_SECRET_KEY must be at least 64 bytes for HS512
# ==========================================
JWT_SECRET_KEY=replace_with_a_secure_64_character_or_longer_secret_key_for_hs512
JWT_ALGORITHM=HS512
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_PRE_AUTH_EXPIRE_MINUTES=5
RESET_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# Storage & Upload Configuration
# ==========================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400

# ==========================================
# CORS Configuration
# ==========================================
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","*"]

# ==========================================
# SMTP Email & Notification Configuration
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
EMAIL_FROM=your_email@gmail.com

# ==========================================
# Predefined Initial Super Admin Bootstrap
# ==========================================
SUPER_ADMIN_TENANT_NAME=TaskFlow Global System
SUPER_ADMIN_FULL_NAME=Root Super Administrator
SUPER_ADMIN_EMAIL=superadmin@taskflow.com
SUPER_ADMIN_PASSWORD=SuperAdmin123!
